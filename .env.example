# ──────────────────────────────────────────────────────────────────────────────
# PUBLIC_HOST — the hostname the *browser* uses to reach the federated MFE
# remotes (ports 5174 / 5175 / 5176).
#
# Why this exists:
#   The shell is the only MFE that loads other MFEs. Its vite.config.ts bakes
#   the remote URLs into the federation plugin at config time:
#     mfe_billing       -> http://${PUBLIC_HOST}:5175/assets/remoteEntry.js
#     mfe_open_account  -> http://${PUBLIC_HOST}:5174/assets/remoteEntry.js
#     mfe_trading       -> http://${PUBLIC_HOST}:5176/assets/remoteEntry.js
#   When a user clicks a route that lazy-loads a remote, the browser fetches
#   those URLs directly — so the hostname must be reachable from the *client
#   machine*, not from the dev server.
#
# When to change:
#   - Single-machine demo (everything on your laptop): leave as "localhost".
#   - LAN demo (other machines on the network open the app): set to this
#     machine's LAN IP, e.g. 192.168.1.223. If you leave it as "localhost",
#     the shell loads fine from the LAN IP but every remote import 404s
#     because the client resolves "localhost" to itself.
#
# How to find your LAN IP:
#   Linux / macOS:  hostname -I   (or: ip route get 1.1.1.1)
#   Windows:        ipconfig
#
# Also required for LAN mode:
#   - Firewall must allow inbound TCP on 5173, 5174, 5175, 5176 on this host.
#   - All four vite servers already bind `host: true`, so they listen on all
#     interfaces — no extra config needed.
#   - Port 3000 (API) does NOT need to be exposed: MFE code calls /api via
#     relative URLs, which resolve against the shell's origin (5173) and are
#     proxied to localhost:3000 on the dev machine.
#
# Restart `npm run dev` after editing — the shell reads this file at config
# time, not at request time.
# ──────────────────────────────────────────────────────────────────────────────
PUBLIC_HOST=localhost
