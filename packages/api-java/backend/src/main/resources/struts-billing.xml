<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
    <!--
        URL patterns (mirroring packages/api/src/domains/billing/billing.router.ts):
          GET  /api/billing/invoices              -> invoices
          GET  /api/billing/invoices/{id}         -> invoices/*  (wildcard {1} -> invoiceId)
          POST /api/billing/invoices/{id}/pay     -> invoices/*/pay
          GET  /api/billing/transactions          -> transactions
          GET  /api/billing/summary               -> summary

        Struts 2 picks the most specific match first, so literal-named
        mappings win over wildcard mappings when both could apply.
    -->
    <package name="billing" extends="default-package" namespace="/api/billing">
        <action name="invoices" class="com.amp.web.billing.ListInvoicesAction">
            <result name="success" type="jsonResult" />
        </action>
        <action name="invoices/*/pay" class="com.amp.web.billing.PayInvoiceAction">
            <param name="invoiceId">{1}</param>
            <result name="success" type="jsonResult" />
        </action>
        <action name="invoices/*" class="com.amp.web.billing.GetInvoiceAction">
            <param name="invoiceId">{1}</param>
            <result name="success" type="jsonResult" />
        </action>
        <action name="transactions" class="com.amp.web.billing.ListTransactionsAction">
            <result name="success" type="jsonResult" />
        </action>
        <action name="summary" class="com.amp.web.billing.BillingSummaryAction">
            <result name="success" type="jsonResult" />
        </action>
    </package>
</struts>
