<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
    <!--
        URL patterns (mirroring packages/api/src/domains/trading/trading.router.ts):
          GET  /api/trading/symbols                -> symbols
          GET  /api/trading/accounts               -> accounts  (trading's cash ledger view)
          GET  /api/trading/cash/{accountId}       -> cash/*
          POST /api/trading/cash/deposit           -> cash/deposit  (literal beats wildcard)
          GET  /api/trading/positions              -> positions  (accountId via query param)
          GET  /api/trading/orders                 -> orders  (list)
          POST /api/trading/orders                 -> orders  (place — branches on method)
          GET  /api/trading/portfolio              -> portfolio  (accountId via query param)
    -->
    <package name="trading" extends="default-package" namespace="/api/trading">
        <action name="symbols" class="com.amp.web.trading.ListSymbolsAction">
            <result name="success" type="jsonResult" />
        </action>
        <action name="accounts" class="com.amp.web.trading.ListTradingAccountsAction">
            <result name="success" type="jsonResult" />
        </action>
        <action name="cash/deposit" class="com.amp.web.trading.DepositAction">
            <result name="success" type="jsonResult" />
        </action>
        <action name="cash/*" class="com.amp.web.trading.GetCashAction">
            <param name="accountId">{1}</param>
            <result name="success" type="jsonResult" />
        </action>
        <action name="positions" class="com.amp.web.trading.ListPositionsAction">
            <result name="success" type="jsonResult" />
        </action>
        <action name="orders" class="com.amp.web.trading.OrdersAction">
            <result name="success" type="jsonResult" />
        </action>
        <action name="portfolio" class="com.amp.web.trading.PortfolioAction">
            <result name="success" type="jsonResult" />
        </action>
    </package>
</struts>
