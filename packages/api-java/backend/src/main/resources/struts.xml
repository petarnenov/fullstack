<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN" "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
    <!-- Frontend calls /api/auth/login etc. — allow extensionless URLs. -->
    <constant name="struts.action.extension" value="," />
    <constant name="struts.enable.DynamicMethodInvocation" value="false" />
    <constant name="struts.devMode" value="true" />
    <constant name="struts.action.excludePattern" value="/h2-console.*" />

    <!-- Default ActionMapper splits the URL at the LAST slash, which breaks
         multi-segment wildcard actions like `invoices/*` and `invoices/*/pay`.
         This custom mapper finds the longest declared namespace and uses the
         full tail as the action name. -->
    <bean type="org.apache.struts2.dispatcher.mapper.ActionMapper"
          name="multiSegment"
          class="com.amp.web.common.MultiSegmentActionMapper" />
    <constant name="struts.mapper.class" value="multiSegment" />

    <package name="default-package" extends="struts-default">
        <result-types>
            <result-type name="jsonResult" class="com.amp.web.common.JsonResult" />
        </result-types>

        <!-- Wraps every action with architecture-visualiser telemetry. The
             interceptor runs first (outermost), so it captures total end-to-end
             time including validation/conversion, and its finally block always
             emits a response event even if an inner interceptor aborts. All
             four domain packages inherit this via `extends="default-package"`,
             so no per-package wiring is required. -->
        <interceptors>
            <interceptor name="telemetry" class="com.amp.web.common.TelemetryInterceptor" />
            <interceptor-stack name="telemetryStack">
                <interceptor-ref name="telemetry" />
                <interceptor-ref name="defaultStack" />
            </interceptor-stack>
        </interceptors>
        <default-interceptor-ref name="telemetryStack" />

        <!-- Global fallback for the `input` result. Struts' validation /
             conversion interceptors short-circuit to `input` before execute()
             runs when they detect binding issues on action fields — we map it
             to the same JSON writer so the action's `response` (typically an
             error JTO or empty string) still reaches the client. -->
        <global-results>
            <result name="input" type="jsonResult" />
        </global-results>
    </package>

    <include file="struts-auth.xml" />
    <include file="struts-billing.xml" />
    <include file="struts-accounts.xml" />
    <include file="struts-trading.xml" />
</struts>
