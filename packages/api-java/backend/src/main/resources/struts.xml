<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN" "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
    <!-- Frontend calls /api/auth/login etc. — allow extensionless URLs. -->
    <constant name="struts.action.extension" value="," />
    <constant name="struts.enable.DynamicMethodInvocation" value="false" />
    <constant name="struts.devMode" value="true" />
    <constant name="struts.action.excludePattern" value="/h2-console.*" />

    <package name="default-package" extends="struts-default">
        <result-types>
            <result-type name="jsonResult" class="com.amp.web.common.JsonResult" />
        </result-types>
    </package>

    <include file="struts-auth.xml" />
</struts>
