{
	"name": "@amp/api",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "jest",
		"test:watch": "jest --watch",
		"generate:swagger": "tsx src/generateSwagger.ts",
		"generate:types:shell": "swagger-typescript-api generate -p ./swagger.json -o ../platform-shell/src/api/generated -n index.ts --modular --axios --extract-request-params --extract-request-body --extract-response-body --extract-response-error",
		"generate:types:billing": "swagger-typescript-api generate -p ./swagger.json -o ../mfe-billing/src/api/generated -n index.ts --modular --axios --extract-request-params --extract-request-body --extract-response-body --extract-response-error",
		"generate:types:accounts": "swagger-typescript-api generate -p ./swagger.json -o ../mfe-open-account/src/api/generated -n index.ts --modular --axios --extract-request-params --extract-request-body --extract-response-body --extract-response-error",
		"generate:types:trading": "swagger-typescript-api generate -p ./swagger.json -o ../mfe-trading/src/api/generated -n index.ts --modular --axios --extract-request-params --extract-request-body --extract-response-body --extract-response-error",
		"generate:types": "npm run generate:swagger && npm run generate:types:shell && npm run generate:types:billing && npm run generate:types:accounts && npm run generate:types:trading"
	},
	"dependencies": {
		"argon2": "^0.44.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^4.19.2",
		"express-rate-limit": "^8.3.2",
		"swagger-ui-express": "^5.0.1",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@jest/globals": "^30.2.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.14.0",
		"@types/swagger-ui-express": "^4.1.6",
		"jest": "^30.2.0",
		"swagger-typescript-api": "^13.0.22",
		"ts-jest": "^29.4.5",
		"tsx": "^4.16.2",
		"typescript": "^5.6.3"
	}
}
